# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules/
/web/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage/
/web/coverage/

# Go build and test output
/pim
/pim.exe
*.test
*.prof
coverage.out

# embedded frontend build output
/internal/web/dist/

# local portable development tools
/.tools/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev-server*.log
.monitor-*.log
/.monitor-processes.json

# local monitoring state and machine-specific configuration
/.venv/
/data/
/backups/
*.db
*.db-shm
*.db-wal
/config.local.json
/config.local.toml
__pycache__/
*.py[cod]
.pytest_cache/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
