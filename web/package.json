{
  "name": "@pim/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html package.json tsconfig.json vite.config.ts vitest.config.ts ../package.json ../scripts/quality.mjs \"../tests/fixtures/contracts/v1/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html package.json tsconfig.json vite.config.ts vitest.config.ts ../package.json ../scripts/quality.mjs \"../tests/fixtures/contracts/v1/*.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "echarts": "6.1.0",
    "i18next": "26.3.6",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "wouter": "3.10.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
